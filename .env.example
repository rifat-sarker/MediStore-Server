NODE_ENV="development"
PORT=5001
DATABASE_URL="postgresql://user:password@localhost:5432/medistore"
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5001"
BCRYPT_SALT_ROUNDS=10

# JWT Auth
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary Storage
CLOUDINARRY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARRY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARRY_API_KEY="your_cloudinary_api_key"

# SMTP Email (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASS="your_16_char_google_app_password"

# SSL Commerz Payment Gateway
SSL_STORE_ID="your_ssl_store_id"
SSL_STORE_PASSWD="your_ssl_store_password"
SSL_IS_LIVE="false"

# Admin Initial Seed
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@medistore.com"
ADMIN_PASSWORD="YourStrongPassword123"